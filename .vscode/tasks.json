{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "BibTeX: run tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["run_tests.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "BibTeX: full demonstration",
      "type": "process",
      "command": "${env:WINDIR}/System32/cmd.exe",
      "args": ["/d", "/c", "RUN_DEMO.cmd", "--no-pause"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
